# Copia questo file in .env e inserisci i dati del progetto Supabase.
# Dashboard Supabase > Connect > Session pooler o Direct connection.
# Per una connessione diretta, esempio:
# jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Se la rete non supporta IPv6, usa la stringa "Session pooler" fornita da Supabase.
SUPABASE_DB_JDBC_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=incolla-qui-la-password-del-database

# URL che il frontend usa dal browser per le API REST.
VITE_API_URL=http://localhost:8080
